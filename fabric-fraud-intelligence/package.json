{
  "name": "fabric-fraud-intelligence",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "template": {
    "name": "todoapp",
    "displayName": "Basic Todo App",
    "description": "End-to-end Fabric-authenticated todo CRUD with a Rayfin data model and per-user row-level security — a working starter that exercises the full data path"
  },
  "scripts": {
    "predev": "rayfin env --framework vite",
    "prebuild": "rayfin env --framework vite",
    "dev": "rayfin up --exclude-services staticHosting && vite",
    "dev:demo": "vite --mode public",
    "build": "tsc -b && vite build",
    "build:fabric": "tsc -b && vite build --mode public",
    "lint": "eslint .",
    "i18n:check": "node scripts/i18n-check.mjs",
    "screenshots": "node scripts/capture-screenshots.mjs",
    "capture:fraud-iq": "node scripts/capture-fraud-iq-video.mjs",
    "preview": "vite preview",
    "test": "vitest run",
    "seed": "echo \"Seed demo data from the app UI (Seed button) or via the Rayfin client; deterministic data is generated by src/data/seed.\"",
    "deploy": "rayfin up",
    "deploy:db": "rayfin up db apply",
    "rayfin:db": "rayfin up db apply"
  },
  "dependencies": {
    "@azure/msal-browser": "^5.19.0",
    "@microsoft/rayfin-auth-provider-fabric": "^1.33.2",
    "@microsoft/rayfin-client": "^1.33.2",
    "@microsoft/rayfin-core": "^1.33.2",
    "@microsoft/rayfin-data": "^1.33.2",
    "@tailwindcss/vite": "^4.1.11",
    "@tanstack/react-query": "^5.102.0",
    "i18next": "^25.2.1",
    "i18next-browser-languagedetector": "^8.0.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-i18next": "^15.5.1",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.1.1",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.21.0",
    "@microsoft/rayfin-cli": "^1.33.2",
    "@testing-library/jest-dom": "^6.4.6",
    "@testing-library/react": "^16.0.0",
    "@testing-library/user-event": "^14.5.2",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@vitejs/plugin-react-swc": "^4.2.2",
    "eslint": "^9.28.0",
    "eslint-plugin-i18next": "^6.1.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.19",
    "globals": "^16.0.0",
    "jsdom": "^24.1.0",
    "tailwindcss": "^4.1.11",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.38.0",
    "vite": "^7.3.2",
    "vitest": "^3.2.4"
  }
}
