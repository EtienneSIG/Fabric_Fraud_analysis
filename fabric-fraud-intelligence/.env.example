# Fabric Fraud Intelligence — environment configuration
# Rayfin injects VITE_* variables at build/deploy time. For local dev copy this
# file to .env.local and adjust. All values are optional in mock mode.

# App mode: "mock" (deterministic demo data) or "fabric" (live Fabric Data Agent)
VITE_FABRIC_APP_MODE=mock

# Bypass Fabric SSO with a synthetic read-only demo identity. Public builds must
# remain in mock mode so anonymous users cannot access protected Fabric resources.
VITE_PUBLIC_DEMO=false

# Microsoft Fabric identifiers (used when VITE_FABRIC_APP_MODE=fabric)
VITE_FABRIC_WORKSPACE_ID=
VITE_FABRIC_DATA_AGENT_ID=
# Rayfin maps RAYFIN_PUBLIC_DATA_AGENT_ID to this equivalent Vite variable.
VITE_RAYFIN_DATA_AGENT_ID=
VITE_FABRIC_TENANT_ID=

# Rayfin runtime (populated automatically by `rayfin up` / `rayfin env`)
# VITE_RAYFIN_API_URL=
# VITE_RAYFIN_PUBLISHABLE_KEY=
# VITE_FABRIC_ITEM_ID=
# VITE_FABRIC_PORTAL_URL=

# --- Real integration backend (Rayfin functions or the Terraform Azure Function) ---
VITE_BACKEND_API_URL=

# --- Microsoft Foundry + Graph (from infra/terraform outputs) ---
VITE_FOUNDRY_ENDPOINT=
VITE_GRAPH_OBO_CLIENT_ID=

# --- Feature flags: only active when VITE_FABRIC_APP_MODE=fabric AND VITE_BACKEND_API_URL is set ---
VITE_FOUNDRY_ENABLED=false   # route agents through the Foundry Agent Service
VITE_WORKIQ_ENABLED=false    # real Work IQ (Microsoft Graph / O365) + Outlook/SharePoint
VITE_WEBIQ_ENABLED=false     # real Web IQ regulatory citations through /api/webiq/search
VITE_TEAMS_ENABLED=false     # Teams approval Adaptive Cards
